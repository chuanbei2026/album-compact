    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to collect photos you've marked into a “To delete” album, so you can double-check them in Photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于把待删除的照片归入一个「待删」相簿，方便你在系统相册里核对。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to your library is needed to find duplicates and clutter screenshots. Everything is analysed on this device; no photo or data is ever uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要读取相册才能找出重复照片与可清理的截图。所有分析都在本机完成， 不会上传任何照片或数据。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
