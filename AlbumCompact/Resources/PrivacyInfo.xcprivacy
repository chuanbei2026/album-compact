<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Nothing is tracked and nothing is collected: the app has no networking
         code at all (verified — the release binary links no CFNetwork and
         references zero URLSession symbols). -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <!-- Required-reason APIs: none are used. The library was checked for file
         timestamp, disk space, active keyboard and user-defaults APIs. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array/>
</dict>
</plist>
